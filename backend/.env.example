# Port the API listens on (Render supplies its own PORT in production).
# 5050 avoids the macOS AirPlay Receiver, which occupies port 5000 by default.
PORT=5050

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vibepost?retryWrites=true&w=majority

# Secret used to sign JSON Web Tokens — use a long random string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed CORS origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# Credential attempts allowed per IP per 15 minutes (defaults to 20)
AUTH_RATE_LIMIT_MAX=20

# Set to "production" on the deployed API so internal error details are masked
NODE_ENV=development

# Cloudinary credentials (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
