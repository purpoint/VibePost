# Base URL of the VibePost API, including the /api suffix.
#
# Local development (the backend's own default port):
VITE_API_URL=http://localhost:5050/api
#
# Production: set this in the Vercel project settings to the deployed API, e.g.
#   VITE_API_URL=https://vibepost-api.onrender.com/api
#
# Vite inlines this value at build time, so it must be present when the build
# runs, not at runtime. `npm run build` refuses to ship a bundle that still
# contains the development fallback when building on a deployment platform.
